# Copy this file to .env and fill in your real values. .env is gitignored.

# FREE SMS via your own Android phone (https://textbee.dev): install the textbee app,
# link the phone, then copy the API key and device ID from the textbee dashboard.
# When both are set, ALL SMS (OTP + weekly price list) go through your phone's SIM.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Fast2SMS API key (paid alternative; its API needs a one-time ₹100 recharge) —
# dealer OTP login/registration + weekly recycler price-list SMS.
# Get it at https://www.fast2sms.com/dashboard/dev-api (needs wallet balance).
FAST2SMS_API_KEY=
# true = if an OTP SMS can't be delivered, show the OTP on screen instead (local demos only!)
OTP_DEMO_MODE=false
# Optional: secret mixed into stored OTP hashes (any long random string)
OTP_SECRET=
# Weekly price-list SMS day/hour (0=Sunday … 6=Saturday, 24h server time). Default Monday 8 AM.
PRICE_SMS_WEEKDAY=1
PRICE_SMS_HOUR=8
# Vercel only: protects the weekly cron endpoint (Vercel sends it automatically)
CRON_SECRET=

# Turso database (only needed in production / on Render — leave blank for local dev,
# which uses a plain local SQLite file at data/esetu.db automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini API key (free tier is fine) for the AI Scrap Scanner's condition grade + description.
# The material itself is identified on the device by YOLO and needs no key.
# Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash; gemini-3.5-flash-lite is cheaper)
GEMINI_MODEL=
.env.example