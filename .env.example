# Copy this file to .env and fill in your real values. .env is gitignored.

# Fast2SMS API key (for the price-list SMS feature)
FAST2SMS_API_KEY=

# Turso database (only needed in production / on Render — leave blank for local dev,
# which uses a plain local SQLite file at data/esetu.db automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Gemini API key for the AI Scrap Scanner (photo -> material + quality grade).
# Get one at https://aistudio.google.com/apikey. Without it the scanner is disabled
# and users pick the material by hand.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.8-flash; gemini-3.5-flash-lite is cheaper)
GEMINI_MODEL=
